# Secrets — never commit service-account keys or credentials.
# The .example.json placeholder is intentionally allowed through so
# contributors can see what's expected without the real file ever
# being tracked.
secrets/*
!secrets/*.example.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Env files
.env

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
